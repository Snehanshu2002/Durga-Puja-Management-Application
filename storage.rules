rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidImageOrPdf() {
      return request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType == null ||
         request.resource.contentType == '' ||
         request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf' ||
         request.resource.contentType == 'application/octet-stream');
    }

    // Event-scoped paths: events/{eventId}/collections/{collectionId}/...
    match /events/{eventId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidImageOrPdf();
      allow delete: if isAuthenticated();
    }

    // Direct legacy / alternative event paths
    match /collections/{eventId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidImageOrPdf();
      allow delete: if isAuthenticated();
    }

    match /expenses/{eventId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidImageOrPdf();
      allow delete: if isAuthenticated();
    }

    match /custody/{eventId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidImageOrPdf();
      allow delete: if isAuthenticated();
    }

    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImageOrPdf();
    }
  }
}
